{
  "manifest_version": 3,
  "name": "Add to ShopKeeper",
  "description": "Send the product you're looking at to ShopKeeper's Add Consumable form.",
  "version": "0.1.0",
  "action": {
    "default_title": "Add to ShopKeeper inventory",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "background": {
    "service_worker": "dist/background.js",
    "type": "module"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": false
  },
  "permissions": ["activeTab", "scripting", "storage"]
}
